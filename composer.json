{
  "name": "blueworx/cgc-championship",
  "description": "CGC Championship tournament platform (demo build).",
  "type": "wordpress-plugin",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "woocommerce/action-scheduler": "^3.8",
    "fakerphp/faker": "^1.23"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/phpstan": "^1.11",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "phpstan/extension-installer": "^1.4"
  },
  "autoload": { "psr-4": { "CGC\\Championship\\": "src/" } },
  "autoload-dev": { "psr-4": { "CGC\\Championship\\Tests\\": "tests/" } },
  "config": {
    "optimize-autoloader": true,
    "platform": { "php": "8.1" },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "analyse": "phpstan analyse --memory-limit=1G"
  }
}
